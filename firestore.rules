rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Author: full edit. Any signed-in user: counter increments (engagement).
      // Admin app (client SDK): status-only merge for ban/unban.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'favCount'])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clicked'])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
      );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      match /likes/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /collections/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /tags/{tagId} {
      allow read: if true;
    }
  }
}
