rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    function userProfileClientFields() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'providerIds',
        'createdAt',
        'lastLoginAt',
      ];
    }

    function userProfileDataValid(userId) {
      let d = request.resource.data;
      return d.uid == userId
        && nullableString(d.email)
        && nullableString(d.displayName)
        && nullableString(d.photoURL)
        && d.providerIds is list
        && (!d.keys().hasAny(['createdAt']) || d.createdAt is timestamp)
        && (!d.keys().hasAny(['lastLoginAt']) || d.lastLoginAt is timestamp);
    }

    function userProfileCreateValid(userId) {
      return request.resource.data.keys().hasOnly(userProfileClientFields())
        && userProfileDataValid(userId);
    }

    function userProfileUpdateValid(userId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(userProfileClientFields())
        && userProfileDataValid(userId);
    }

    function recipeCreateCountersValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['likeCount']) ||
          (d.likeCount is int && d.likeCount == 0))
        && (!d.keys().hasAny(['favCount']) ||
          (d.favCount is int && d.favCount == 0))
        && (!d.keys().hasAny(['commentCount']) ||
          (d.commentCount is int && d.commentCount == 0));
    }

    function recipeCreateStatusValid() {
      return !request.resource.data.keys().hasAny(['status'])
        || request.resource.data.status == 'active';
    }

    function recipeOwnerUpdateValid() {
      return resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'authorUid',
          'createdAt',
          'status',
          'likeCount',
          'favCount',
          'commentCount',
          'clicked',
          'click_metrics',
        ]);
    }

    function likeCountIncrementValid() {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount'])
        && d.likeCount is int
        && d.likeCount >= 0
        && (
          (resource.data.likeCount is int &&
            (d.likeCount == resource.data.likeCount + 1 ||
              d.likeCount == resource.data.likeCount - 1))
          || (!resource.data.keys().hasAny(['likeCount']) && d.likeCount == 1)
        );
    }

    function favCountIncrementValid() {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['favCount'])
        && d.favCount is int
        && d.favCount >= 0
        && (
          (resource.data.favCount is int &&
            (d.favCount == resource.data.favCount + 1 ||
              d.favCount == resource.data.favCount - 1))
          || (!resource.data.keys().hasAny(['favCount']) && d.favCount == 1)
        );
    }

    function recipeStatusUpdateValid() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status in ['active', 'banned'];
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && recipeCreateCountersValid()
        && recipeCreateStatusValid();
      // Authors can edit recipe content, but not ownership/moderation/derived fields.
      // Any signed-in user may only apply a single +/-1 engagement counter update.
      // Admin app (client SDK): status-only merge for ban/unban.
      allow update: if request.auth != null && (
        recipeOwnerUpdateValid()
        || likeCountIncrementValid()
        || favCountIncrementValid()
        || recipeStatusUpdateValid()
      );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && userProfileCreateValid(userId);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && userProfileUpdateValid(userId);

      match /likes/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /collections/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /tags/{tagId} {
      allow read: if true;
    }

    // --- System configs (admin panel settings) ---
    match /system_configs/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Dashboard materialized metrics (admin read only) ---
    match /admin_metrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Recipe click events (append-only ML telemetry; aggregation via Cloud Functions) ---
    // Note: `FieldValue.serverTimestamp()` may not appear in `keys()` during rule evaluation.
    function recipeClickEventKeysAllowed() {
      return request.resource.data.keys().removeAll([
        'recipeId', 'userId', 'clickSource', 'timestamp',
        'locationName', 'weatherCategory',
        'temperature', 'feelsLike', 'humidity', 'precipitation', 'conditionCode',
        'currentWeatherCode'
      ]).size() == 0;
    }

    function recipeClickEventWeatherFieldsValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['locationName']) || d.locationName is string)
        && (!d.keys().hasAny(['weatherCategory']) || d.weatherCategory is string)
        && (!d.keys().hasAny(['temperature']) || d.temperature is number)
        && (!d.keys().hasAny(['feelsLike']) || d.feelsLike is number)
        && (!d.keys().hasAny(['humidity']) || d.humidity is number)
        && (!d.keys().hasAny(['precipitation']) || d.precipitation is number)
        && (!d.keys().hasAny(['conditionCode']) || d.conditionCode is int)
        && (!d.keys().hasAny(['currentWeatherCode']) || d.currentWeatherCode is string);
    }

    match /recipe_click_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.clickSource is string
        && request.resource.data.clickSource in ['weather_promoted', 'weather_notpromoted', 'normal_browse', 'search']
        && recipeClickEventKeysAllowed()
        && recipeClickEventWeatherFieldsValid();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
