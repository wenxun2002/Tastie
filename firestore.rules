rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidRecipeCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'authorUid',
          'author',
          'imageUrls',
          'title',
          'content',
          'tags',
          'ingredients',
          'procedures',
          'nutrition',
          'likeCount',
          'favCount',
          'commentCount',
          'createdAt',
          'status',
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'authorUid',
          'author',
          'imageUrls',
          'title',
          'content',
          'tags',
          'ingredients',
          'procedures',
          'likeCount',
          'favCount',
          'commentCount',
          'createdAt',
          'status',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.likeCount == 0
        && request.resource.data.favCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
    }

    function isAuthorRecipeUpdate() {
      return isOwner(resource.data.userId)
        && !changedKeys().hasAny([
          'userId',
          'authorUid',
          'createdAt',
          'status',
          'likeCount',
          'favCount',
          'commentCount',
        ]);
    }

    function isAdminStatusUpdate() {
      return isAdmin()
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status is string;
    }

    function isLikeIncrement(recipeId) {
      return changedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == resource.data.likeCount + 1
        && request.resource.data.likeCount >= 0
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId)).data.recipeId == recipeId;
    }

    function isLikeDecrement(recipeId) {
      return changedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == resource.data.likeCount - 1
        && request.resource.data.likeCount >= 0
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId));
    }

    function isFavoriteIncrement(recipeId) {
      return changedKeys().hasOnly(['favCount'])
        && request.resource.data.favCount == resource.data.favCount + 1
        && request.resource.data.favCount >= 0
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId)).data.recipeId == recipeId;
    }

    function isFavoriteDecrement(recipeId) {
      return changedKeys().hasOnly(['favCount'])
        && request.resource.data.favCount == resource.data.favCount - 1
        && request.resource.data.favCount >= 0
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId));
    }

    function isValidEngagementCounterUpdate(recipeId) {
      return signedIn() && (
        isLikeIncrement(recipeId)
        || isLikeDecrement(recipeId)
        || isFavoriteIncrement(recipeId)
        || isFavoriteDecrement(recipeId)
      );
    }

    function isValidReportCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'recipeId',
          'recipeTitle',
          'authorUsername',
          'reportedBy',
          'reason',
          'description',
          'timestamp',
        ])
        && request.resource.data.keys().hasAll([
          'recipeId',
          'recipeTitle',
          'authorUsername',
          'reportedBy',
          'reason',
          'description',
          'timestamp',
        ])
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.recipeTitle is string
        && request.resource.data.authorUsername is string
        && request.resource.data.reason is string
        && request.resource.data.description is string
        && request.resource.data.timestamp == request.time;
    }

    function isValidLikeCreate(userId, recipeId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
        && request.resource.data.keys().hasAll(['recipeId', 'createdAt'])
        && request.resource.data.recipeId == recipeId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/recipes/$(recipeId))
        && existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
        && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.likeCount
          == get(/databases/$(database)/documents/recipes/$(recipeId)).data.likeCount + 1;
    }

    function isValidLikeDelete(userId, recipeId) {
      return isOwner(userId)
        && (
          !exists(/databases/$(database)/documents/recipes/$(recipeId))
          || (
            existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.likeCount
              == get(/databases/$(database)/documents/recipes/$(recipeId)).data.likeCount - 1
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.likeCount >= 0
          )
        );
    }

    function isValidCollectionCreate(userId, recipeId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
        && request.resource.data.keys().hasAll(['recipeId', 'createdAt'])
        && request.resource.data.recipeId == recipeId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/recipes/$(recipeId))
        && existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
        && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.favCount
          == get(/databases/$(database)/documents/recipes/$(recipeId)).data.favCount + 1;
    }

    function isValidCollectionDelete(userId, recipeId) {
      return isOwner(userId)
        && (
          !exists(/databases/$(database)/documents/recipes/$(recipeId))
          || (
            existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.favCount
              == get(/databases/$(database)/documents/recipes/$(recipeId)).data.favCount - 1
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.favCount >= 0
          )
        );
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isValidRecipeCreate();
      allow update: if isAuthorRecipeUpdate()
        || isValidEngagementCounterUpdate(recipeId)
        || isAdminStatusUpdate();
      allow delete: if isOwner(resource.data.userId);
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);

      match /likes/{recipeId} {
        allow read: if isOwner(userId);
        allow create: if isValidLikeCreate(userId, recipeId);
        allow update: if false;
        allow delete: if isValidLikeDelete(userId, recipeId);
      }

      match /collections/{recipeId} {
        allow read: if isOwner(userId);
        allow create: if isValidCollectionCreate(userId, recipeId);
        allow update: if false;
        allow delete: if isValidCollectionDelete(userId, recipeId);
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if isValidReportCreate();
      allow update, delete: if false;
    }

    match /card_details/{docId} {
      allow read: if true;
    }

    match /tags/{tagId} {
      allow read: if true;
    }
  }
}
