rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userLikePath(recipeId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId);
    }

    function userCollectionPath(recipeId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isLikeCounterChange(recipeId) {
      return changedOnly(['likeCount'])
        && (
          (
            request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(userLikePath(recipeId))
            && existsAfter(userLikePath(recipeId))
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount - 1
            && request.resource.data.likeCount >= 0
            && exists(userLikePath(recipeId))
            && !existsAfter(userLikePath(recipeId))
          )
        );
    }

    function isFavoriteCounterChange(recipeId) {
      return changedOnly(['favCount'])
        && (
          (
            request.resource.data.favCount == resource.data.favCount + 1
            && !exists(userCollectionPath(recipeId))
            && existsAfter(userCollectionPath(recipeId))
          )
          || (
            request.resource.data.favCount == resource.data.favCount - 1
            && request.resource.data.favCount >= 0
            && exists(userCollectionPath(recipeId))
            && !existsAfter(userCollectionPath(recipeId))
          )
        );
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Authors can edit their recipes. Engagement counter updates must be
      // paired with the caller's like/collection marker in the same commit.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || isLikeCounterChange(recipeId)
        || isFavoriteCounterChange(recipeId)
      );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      match /likes/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /collections/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /card_details/{docId} {
      allow read: if true;
    }

    match /tags/{tagId} {
      allow read: if true;
    }
  }
}
