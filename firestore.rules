rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function recipePath(recipeId) {
      return /databases/$(database)/documents/recipes/$(recipeId);
    }

    function likePath(recipeId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId);
    }

    function collectionPath(recipeId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId);
    }

    function recipeChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function ownsExistingRecipe() {
      return isOwner(resource.data.userId);
    }

    function recipeIdentityIsUnchanged() {
      return !recipeChangedKeys().hasAny([
        'userId',
        'authorUid',
        'status',
        'likeCount',
        'favCount',
      ]);
    }

    function isValidRecipeCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('authorUid' in request.resource.data)
          || request.resource.data.authorUid == request.auth.uid)
        && (!('status' in request.resource.data)
          || request.resource.data.status == 'active')
        && request.resource.data.likeCount == 0
        && request.resource.data.favCount == 0;
    }

    function isValidLikeCountIncrement(recipeId) {
      return recipeChangedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == resource.data.likeCount + 1
        && !exists(likePath(recipeId))
        && existsAfter(likePath(recipeId));
    }

    function isValidLikeCountDecrement(recipeId) {
      return recipeChangedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == resource.data.likeCount - 1
        && request.resource.data.likeCount >= 0
        && exists(likePath(recipeId))
        && !existsAfter(likePath(recipeId));
    }

    function isValidFavoriteCountIncrement(recipeId) {
      return recipeChangedKeys().hasOnly(['favCount'])
        && request.resource.data.favCount == resource.data.favCount + 1
        && !exists(collectionPath(recipeId))
        && existsAfter(collectionPath(recipeId));
    }

    function isValidFavoriteCountDecrement(recipeId) {
      return recipeChangedKeys().hasOnly(['favCount'])
        && request.resource.data.favCount == resource.data.favCount - 1
        && request.resource.data.favCount >= 0
        && exists(collectionPath(recipeId))
        && !existsAfter(collectionPath(recipeId));
    }

    function isValidEngagementCounterUpdate(recipeId) {
      return isSignedIn() && (
        isValidLikeCountIncrement(recipeId)
        || isValidLikeCountDecrement(recipeId)
        || isValidFavoriteCountIncrement(recipeId)
        || isValidFavoriteCountDecrement(recipeId)
      );
    }

    function isValidEngagementCreate(recipeId, counterField) {
      return request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
        && request.resource.data.keys().hasAll(['recipeId', 'createdAt'])
        && request.resource.data.recipeId == recipeId
        && request.resource.data.createdAt is timestamp
        && exists(recipePath(recipeId))
        && existsAfter(recipePath(recipeId))
        && getAfter(recipePath(recipeId)).data[counterField]
          == get(recipePath(recipeId)).data[counterField] + 1;
    }

    function isValidEngagementDelete(recipeId, counterField) {
      return exists(recipePath(recipeId))
        && existsAfter(recipePath(recipeId))
        && getAfter(recipePath(recipeId)).data[counterField]
          == get(recipePath(recipeId)).data[counterField] - 1
        && getAfter(recipePath(recipeId)).data[counterField] >= 0;
    }

    function isValidReportCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'recipeId',
          'recipeTitle',
          'authorUsername',
          'reportedBy',
          'reason',
          'description',
          'timestamp',
        ])
        && request.resource.data.keys().hasAll([
          'recipeId',
          'recipeTitle',
          'authorUsername',
          'reportedBy',
          'reason',
          'description',
          'timestamp',
        ])
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.timestamp is timestamp;
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isValidRecipeCreate();
      // Authors may edit recipe content but cannot reassign ownership,
      // self-moderate status, or spoof aggregate engagement counters.
      allow update: if (
        ownsExistingRecipe() && recipeIdentityIsUnchanged()
      ) || (
        isAdmin() && recipeChangedKeys().hasOnly(['status'])
      ) || (
        isValidEngagementCounterUpdate(recipeId)
      );
      allow delete: if ownsExistingRecipe();
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;

      match /likes/{recipeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidEngagementCreate(recipeId, 'likeCount');
        allow update: if false;
        allow delete: if isOwner(userId)
          && isValidEngagementDelete(recipeId, 'likeCount');
      }

      match /collections/{recipeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidEngagementCreate(recipeId, 'favCount');
        allow update: if false;
        allow delete: if isOwner(userId)
          && isValidEngagementDelete(recipeId, 'favCount');
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isValidReportCreate();
      allow update, delete: if false;
    }

    match /card_details/{docId} {
      allow read: if true;
    }

    match /tags/{tagId} {
      allow read: if true;
    }
  }
}
