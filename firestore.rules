rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Author: full edit. Any signed-in user: counter increments (engagement).
      // Admin app (client SDK): status-only merge for ban/unban.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'favCount'])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clicked'])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
      );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      match /likes/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /collections/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /tags/{tagId} {
      allow read: if true;
    }

    // --- System configs (admin panel settings) ---
    match /system_configs/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Dashboard materialized metrics (admin read only) ---
    match /admin_metrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Recipe click events (append-only ML telemetry; aggregation via Cloud Functions) ---
    // Note: `FieldValue.serverTimestamp()` may not appear in `keys()` during rule
    // evaluation, so we allow 3–5 key shapes (with/without timestamp and weather).
    match /recipe_click_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.clickSource is string
        && request.resource.data.clickSource in ['weather_promoted', 'weather_notpromoted', 'normal_browse', 'search']
        && (
             request.resource.data.keys().hasOnly(['recipeId', 'userId', 'clickSource'])
          || request.resource.data.keys().hasOnly(['recipeId', 'userId', 'clickSource', 'timestamp'])
          || request.resource.data.keys().hasOnly(['recipeId', 'userId', 'clickSource', 'currentWeatherCode'])
          || request.resource.data.keys().hasOnly(['recipeId', 'userId', 'clickSource', 'timestamp', 'currentWeatherCode'])
           )
        && (!request.resource.data.keys().hasAny(['currentWeatherCode'])
            || request.resource.data.currentWeatherCode is string);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
