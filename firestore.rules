rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function recipeInitialClickMetricsValid(metrics) {
      return metrics is map
        && metrics.keys().hasOnly([
          'weather_promoted',
          'weather_notpromoted',
          'normal_browse',
          'search',
          'total'
        ])
        && metrics.weather_promoted == 0
        && metrics.weather_notpromoted == 0
        && metrics.normal_browse == 0
        && metrics.search == 0
        && metrics.total == 0;
    }

    function recipeInitialSystemFieldsValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['status']) || d.status == 'active')
        && !d.keys().hasAny(['clicked'])
        && (!d.keys().hasAny(['click_metrics']) ||
          recipeInitialClickMetricsValid(d.click_metrics));
    }

    function recipeSystemFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'clicked', 'click_metrics']);
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && recipeInitialSystemFieldsValid();
      // Author: full edit except server/admin-managed fields.
      // Any signed-in user: counter increments (engagement).
      // Admin app (client SDK): status-only merge for ban/unban.
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid && !recipeSystemFieldsChanged())
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'favCount'])
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
        )
      );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      match /likes/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /collections/{recipeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // --- Reports (mobile creates; admin console reads with same auth) ---
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /tags/{tagId} {
      allow read: if true;
    }

    // --- System configs (admin panel settings) ---
    match /system_configs/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Dashboard materialized metrics (admin read only) ---
    match /admin_metrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Recipe click events (append-only ML telemetry; aggregation via Cloud Functions) ---
    // Note: `FieldValue.serverTimestamp()` may not appear in `keys()` during rule evaluation.
    function recipeClickEventKeysAllowed() {
      return request.resource.data.keys().removeAll([
        'recipeId', 'userId', 'clickSource', 'timestamp',
        'locationName', 'weatherCategory',
        'temperature', 'feelsLike', 'humidity', 'precipitation', 'conditionCode',
        'currentWeatherCode'
      ]).size() == 0;
    }

    function recipeClickEventWeatherFieldsValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['locationName']) || d.locationName is string)
        && (!d.keys().hasAny(['weatherCategory']) || d.weatherCategory is string)
        && (!d.keys().hasAny(['temperature']) || d.temperature is number)
        && (!d.keys().hasAny(['feelsLike']) || d.feelsLike is number)
        && (!d.keys().hasAny(['humidity']) || d.humidity is number)
        && (!d.keys().hasAny(['precipitation']) || d.precipitation is number)
        && (!d.keys().hasAny(['conditionCode']) || d.conditionCode is int)
        && (!d.keys().hasAny(['currentWeatherCode']) || d.currentWeatherCode is string);
    }

    match /recipe_click_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.clickSource is string
        && request.resource.data.clickSource in ['weather_promoted', 'weather_notpromoted', 'normal_browse', 'search']
        && recipeClickEventKeysAllowed()
        && recipeClickEventWeatherFieldsValid();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
