rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function signedInUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(signedInUserPath())
        && get(signedInUserPath()).data.role == 'admin';
    }

    function isNotBannedUser() {
      return isSignedIn()
        && exists(signedInUserPath())
        && (!get(signedInUserPath()).data.keys().hasAny(['status'])
          || get(signedInUserPath()).data.status != 'banned');
    }

    // --- Recipes (feed + engagement counters on same doc) ---
    match /recipes/{recipeId} {
      function recipePath() {
        return /databases/$(database)/documents/recipes/$(recipeId);
      }

      function signedInUserLikePath() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(recipeId);
      }

      function signedInUserCollectionPath() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/collections/$(recipeId);
      }

      function recipeCreateCountersValid() {
        let d = request.resource.data;
        return (!d.keys().hasAny(['likeCount']) || d.likeCount == 0)
          && (!d.keys().hasAny(['favCount']) || d.favCount == 0)
          && (!d.keys().hasAny(['commentCount']) || d.commentCount == 0)
          && (!d.keys().hasAny(['clicked']) || d.clicked == 0)
          && (!d.keys().hasAny(['click_metrics']) || (
            d.click_metrics is map
            && d.click_metrics.weather_promoted == 0
            && d.click_metrics.weather_notpromoted == 0
            && d.click_metrics.normal_browse == 0
            && d.click_metrics.search == 0
            && d.click_metrics.total == 0
          ));
      }

      function recipeAuthorValid() {
        let author = request.resource.data.author;
        return author is map
          && author.keys().hasOnly(['nickname', 'avatar'])
          && (!author.keys().hasAny(['nickname']) || author.nickname is string)
          && (!author.keys().hasAny(['avatar']) || author.avatar is string);
      }

      function recipeNutritionValid() {
        let nutrition = request.resource.data.nutrition;
        return nutrition is map
          && nutrition.keys().hasOnly([
            'calories', 'protein', 'carbs', 'fat', 'fiber', 'sugar'
          ])
          && (!nutrition.keys().hasAny(['calories']) || nutrition.calories is number)
          && (!nutrition.keys().hasAny(['protein']) || nutrition.protein is number)
          && (!nutrition.keys().hasAny(['carbs']) || nutrition.carbs is number)
          && (!nutrition.keys().hasAny(['fat']) || nutrition.fat is number)
          && (!nutrition.keys().hasAny(['fiber']) || nutrition.fiber is number)
          && (!nutrition.keys().hasAny(['sugar']) || nutrition.sugar is number);
      }

      function recipePublicFieldsValid() {
        let d = request.resource.data;
        return d.userId is string
          && (!d.keys().hasAny(['authorUid']) || d.authorUid is string)
          && (!d.keys().hasAny(['author']) || recipeAuthorValid())
          && (!d.keys().hasAny(['imageUrls']) || d.imageUrls is list)
          && (!d.keys().hasAny(['title']) || d.title is string)
          && (!d.keys().hasAny(['content']) || d.content is string)
          && (!d.keys().hasAny(['tags']) || d.tags is list)
          && (!d.keys().hasAny(['ingredients']) || d.ingredients is list)
          && (!d.keys().hasAny(['procedures']) || d.procedures is list)
          && (!d.keys().hasAny(['nutrition']) || recipeNutritionValid())
          && (!d.keys().hasAny(['createdAt']) || d.createdAt is timestamp);
      }

      function recipeCreateKeysValid() {
        return request.resource.data.keys().hasOnly([
          'userId', 'authorUid', 'author', 'imageUrls', 'title', 'content',
          'tags', 'ingredients', 'procedures', 'nutrition',
          'likeCount', 'favCount', 'commentCount', 'clicked',
          'click_metrics', 'status', 'createdAt'
        ]);
      }

      function recipeCreateAllowed() {
        let d = request.resource.data;
        return isSignedIn()
          && isNotBannedUser()
          && d.userId == request.auth.uid
          && (!d.keys().hasAny(['authorUid']) || d.authorUid == request.auth.uid)
          && (!d.keys().hasAny(['status']) || d.status == 'active')
          && recipeCreateKeysValid()
          && recipePublicFieldsValid()
          && recipeCreateCountersValid();
      }

      function recipeOwnerUpdateAllowed() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && affected.hasOnly([
            'author', 'imageUrls', 'title', 'content', 'tags',
            'ingredients', 'procedures', 'nutrition'
          ])
          && recipePublicFieldsValid();
      }

      function likeCountChangeValid() {
        return resource.data.likeCount is number
          && request.resource.data.likeCount is number
          && request.resource.data.likeCount >= 0
          && (
            (
              request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(signedInUserLikePath())
              && existsAfter(signedInUserLikePath())
            )
            || (
              request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(signedInUserLikePath())
              && !existsAfter(signedInUserLikePath())
            )
          );
      }

      function favCountChangeValid() {
        return resource.data.favCount is number
          && request.resource.data.favCount is number
          && request.resource.data.favCount >= 0
          && (
            (
              request.resource.data.favCount == resource.data.favCount + 1
              && !exists(signedInUserCollectionPath())
              && existsAfter(signedInUserCollectionPath())
            )
            || (
              request.resource.data.favCount == resource.data.favCount - 1
              && exists(signedInUserCollectionPath())
              && !existsAfter(signedInUserCollectionPath())
            )
          );
      }

      function recipeCounterUpdateAllowed() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && affected.hasOnly(['likeCount', 'favCount'])
          && (!affected.hasAny(['likeCount']) || likeCountChangeValid())
          && (!affected.hasAny(['favCount']) || favCountChangeValid());
      }

      function recipeAdminStatusUpdateAllowed() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'banned'];
      }

      function recipeAdminAuthorUpdateAllowed() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author'])
          && request.resource.data.author is map
          && request.resource.data.author.keys().hasOnly(['nickname', 'avatar'])
          && request.resource.data.author.nickname is string
          && request.resource.data.author.avatar is string;
      }

      allow read: if true;
      allow create: if recipeCreateAllowed();
      // Owners can edit content, engagement updates must be coupled with the
      // user's like/collection doc, and moderation status is admin-only.
      allow update: if recipeOwnerUpdateAllowed()
        || recipeCounterUpdateAllowed()
        || recipeAdminStatusUpdateAllowed()
        || recipeAdminAuthorUpdateAllowed();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- User profile + per-user likes / collections ---
    match /users/{userId} {
      function userProfileCreateAllowed() {
        let d = request.resource.data;
        return isSignedIn()
          && request.auth.uid == userId
          && d.keys().hasOnly([
            'uid', 'email', 'displayName', 'photoURL',
            'providerIds', 'lastLoginAt', 'createdAt'
          ])
          && userProfileFieldsValid(userId);
      }

      function userProfileUpdateAllowed() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && request.auth.uid == userId
          && affected.hasOnly([
            'uid', 'email', 'displayName', 'photoURL',
            'providerIds', 'lastLoginAt', 'createdAt'
          ])
          && (!resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt == resource.data.createdAt)
          && userProfileFieldsValid(userId);
      }

      function userAdminStatusUpdateAllowed() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'banned'];
      }

      function userProfileFieldsValid(expectedUid) {
        let d = request.resource.data;
        return d.uid == expectedUid
          && (!d.keys().hasAny(['email']) || d.email is string || d.email == null)
          && (!d.keys().hasAny(['displayName']) || d.displayName is string || d.displayName == null)
          && (!d.keys().hasAny(['photoURL']) || d.photoURL is string || d.photoURL == null)
          && (!d.keys().hasAny(['providerIds']) || d.providerIds is list)
          && (!d.keys().hasAny(['lastLoginAt']) || d.lastLoginAt is timestamp)
          && (!d.keys().hasAny(['createdAt']) || d.createdAt is timestamp);
      }

      function recipeExistsAndLikeCountChangedBy(targetRecipeId, delta) {
        return exists(/databases/$(database)/documents/recipes/$(targetRecipeId))
          && getAfter(/databases/$(database)/documents/recipes/$(targetRecipeId)).data.likeCount ==
            get(/databases/$(database)/documents/recipes/$(targetRecipeId)).data.likeCount + delta;
      }

      function recipeExistsAndFavCountChangedBy(targetRecipeId, delta) {
        return exists(/databases/$(database)/documents/recipes/$(targetRecipeId))
          && getAfter(/databases/$(database)/documents/recipes/$(targetRecipeId)).data.favCount ==
            get(/databases/$(database)/documents/recipes/$(targetRecipeId)).data.favCount + delta;
      }

      function engagementDocCreateAllowed(targetRecipeId) {
        return isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
          && request.resource.data.recipeId == targetRecipeId
          && (!request.resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt is timestamp);
      }

      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if userProfileCreateAllowed();
      allow update: if userProfileUpdateAllowed()
        || userAdminStatusUpdateAllowed();

      match /likes/{recipeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if engagementDocCreateAllowed(recipeId)
          && recipeExistsAndLikeCountChangedBy(recipeId, 1);
        allow delete: if isSignedIn()
          && request.auth.uid == userId
          && recipeExistsAndLikeCountChangedBy(recipeId, -1);
        allow update: if false;
      }

      match /collections/{recipeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if engagementDocCreateAllowed(recipeId)
          && recipeExistsAndFavCountChangedBy(recipeId, 1);
        allow delete: if isSignedIn()
          && request.auth.uid == userId
          && recipeExistsAndFavCountChangedBy(recipeId, -1);
        allow update: if false;
      }
    }

    // --- Reports (mobile creates; admin resolves via status only) ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'solved'];
      allow delete: if false;
    }

    match /tags/{tagId} {
      allow read: if true;
    }

    // --- Search ingredients (mobile search chips; admin CRUD) ---
    match /Search_ingredient/{ingredientId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- System configs (admin panel settings) ---
    match /system_configs/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Dashboard materialized metrics (admin read only) ---
    match /admin_metrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Recipe click events (append-only ML telemetry; aggregation via Cloud Functions) ---
    // Note: `FieldValue.serverTimestamp()` may not appear in `keys()` during rule evaluation.
    function recipeClickEventKeysAllowed() {
      return request.resource.data.keys().removeAll([
        'recipeId', 'userId', 'clickSource', 'timestamp',
        'locationName', 'weatherCategory',
        'temperature', 'feelsLike', 'humidity', 'precipitation', 'conditionCode',
        'currentWeatherCode'
      ]).size() == 0;
    }

    function recipeClickEventWeatherFieldsValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['locationName']) || d.locationName is string)
        && (!d.keys().hasAny(['weatherCategory']) || d.weatherCategory is string)
        && (!d.keys().hasAny(['temperature']) || d.temperature is number)
        && (!d.keys().hasAny(['feelsLike']) || d.feelsLike is number)
        && (!d.keys().hasAny(['humidity']) || d.humidity is number)
        && (!d.keys().hasAny(['precipitation']) || d.precipitation is number)
        && (!d.keys().hasAny(['conditionCode']) || d.conditionCode is int)
        && (!d.keys().hasAny(['currentWeatherCode']) || d.currentWeatherCode is string);
    }

    match /recipe_click_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.clickSource is string
        && request.resource.data.clickSource in ['weather_promoted', 'weather_notpromoted', 'normal_browse', 'search']
        && recipeClickEventKeysAllowed()
        && recipeClickEventWeatherFieldsValid();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
